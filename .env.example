# Shoonya OAuth APP credentials, from your Shoonya account's API page.
# Keep these on the server and NEVER paste them in the browser or commit them.
SHOONYA_CLIENT_ID=
SHOONYA_SECRET_CODE=
# Can be provided when your credentials use a distinct login account name.
SHOONYA_USER_ID=
# Optional: existing SESSION token for this run, expires after 24 hours.
SHOONYA_ACCESS_TOKEN=
SHOONYA_ACCOUNT_ID=
# For whitelisted IPv6 deployments only: https://trade.shoonya.com/OAuthlogin/authorize/oauth
SHOONYA_OAUTH_URL=https://api.shoonya.com/OAuthlogin/authorize/oauth
